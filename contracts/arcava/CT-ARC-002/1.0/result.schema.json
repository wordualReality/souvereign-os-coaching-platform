{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcava:CT-ARC-002:1.0:result",
  "title": "CT-ARC-002 result v1.0",
  "allOf": [
    {
      "$ref": "urn:arcava:types:1.0:ResponseEnvelope#/$defs/responseEnvelopeBase"
    },
    {
      "type": "object",
      "required": [
        "payload"
      ],
      "properties": {
        "contract_id": {
          "const": "CT-ARC-002"
        },
        "schema_version": {
          "const": "1.0"
        },
        "outcome": {
          "const": "OK"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "journey_id",
            "journey_version_id",
            "publication_state",
            "published_at",
            "content_hash",
            "phases",
            "review_ref"
          ],
          "properties": {
            "journey_id": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "latest"
              }
            },
            "journey_version_id": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "latest"
              }
            },
            "publication_state": {
              "enum": [
                "DRAFT",
                "IN_REVIEW",
                "APPROVED",
                "PUBLISHED",
                "SUPERSEDED",
                "WITHDRAWN"
              ]
            },
            "published_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "phase_id",
                  "ordinal",
                  "steps"
                ],
                "properties": {
                  "phase_id": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "const": "latest"
                    }
                  },
                  "ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "step_id",
                        "ordinal",
                        "canonical_bindings",
                        "execution_profile_ref"
                      ],
                      "properties": {
                        "step_id": {
                          "type": "string",
                          "minLength": 1,
                          "not": {
                            "const": "latest"
                          }
                        },
                        "ordinal": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "source_ref": {
                          "oneOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "schema_version",
                                "variant",
                                "protocol_id",
                                "protocol_version_id",
                                "owning_module_id",
                                "taxonomy_version_id",
                                "relation_ids"
                              ],
                              "properties": {
                                "schema_version": {
                                  "const": 1
                                },
                                "variant": {
                                  "const": "KDB_PROTOCOL_VERSION"
                                },
                                "protocol_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "not": {
                                    "const": "latest"
                                  }
                                },
                                "protocol_version_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "not": {
                                    "const": "latest"
                                  }
                                },
                                "owning_module_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "not": {
                                    "const": "latest"
                                  }
                                },
                                "taxonomy_version_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "not": {
                                    "const": "latest"
                                  }
                                },
                                "relation_ids": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "not": {
                                      "const": "latest"
                                    }
                                  }
                                }
                              }
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "schema_version",
                                "variant",
                                "journey_version_id",
                                "journey_step_id"
                              ],
                              "properties": {
                                "schema_version": {
                                  "const": 1
                                },
                                "variant": {
                                  "const": "ARCAVA_DELIVERY_BINDING"
                                },
                                "journey_version_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "not": {
                                    "const": "latest"
                                  }
                                },
                                "journey_step_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "not": {
                                    "const": "latest"
                                  }
                                },
                                "journey_step_version": {
                                  "type": "string"
                                },
                                "programme_module_binding_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "not": {
                                    "const": "latest"
                                  }
                                },
                                "programme_binding_revision": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$"
                                },
                                "programme_binding_hash": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{64}$"
                                }
                              },
                              "allOf": [
                                {
                                  "if": {
                                    "required": [
                                      "programme_module_binding_id"
                                    ]
                                  },
                                  "then": {
                                    "required": [
                                      "programme_binding_revision",
                                      "programme_binding_hash"
                                    ]
                                  }
                                },
                                {
                                  "if": {
                                    "anyOf": [
                                      {
                                        "required": [
                                          "programme_binding_revision"
                                        ]
                                      },
                                      {
                                        "required": [
                                          "programme_binding_hash"
                                        ]
                                      }
                                    ]
                                  },
                                  "then": {
                                    "required": [
                                      "programme_module_binding_id",
                                      "programme_binding_revision",
                                      "programme_binding_hash"
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        "canonical_bindings": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "canonical_ref",
                              "object_type",
                              "publication_state",
                              "rights_state",
                              "allowed_use",
                              "evidence_class",
                              "safety_state",
                              "policy_version",
                              "safety_constraint_refs",
                              "provenance",
                              "lifecycle_revision",
                              "integrity_hash",
                              "binding_hash",
                              "relation_refs"
                            ],
                            "properties": {
                              "canonical_ref": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "producer_namespace",
                                  "object_type",
                                  "stable_id",
                                  "immutable_version_id"
                                ],
                                "properties": {
                                  "producer_namespace": {
                                    "const": "KDB"
                                  },
                                  "object_type": {
                                    "const": "CanonicalKnowledgeItem"
                                  },
                                  "stable_id": {
                                    "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                  },
                                  "immutable_version_id": {
                                    "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                  }
                                }
                              },
                              "object_type": {
                                "type": "string",
                                "minLength": 1
                              },
                              "publication_state": {
                                "enum": [
                                  "DRAFT",
                                  "IN_REVIEW",
                                  "PUBLISHED",
                                  "SUPERSEDED",
                                  "WITHDRAWN"
                                ]
                              },
                              "rights_state": {
                                "type": "string",
                                "minLength": 1
                              },
                              "allowed_use": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "evidence_class": {
                                "type": "string",
                                "minLength": 1
                              },
                              "safety_state": {
                                "type": "string",
                                "minLength": 1
                              },
                              "policy_version": {
                                "type": "string"
                              },
                              "safety_constraint_refs": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "producer_namespace",
                                    "object_type",
                                    "stable_id"
                                  ],
                                  "properties": {
                                    "producer_namespace": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "object_type": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "stable_id": {
                                      "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                    }
                                  }
                                }
                              },
                              "provenance": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "source_version_ref",
                                    "kind",
                                    "locator"
                                  ],
                                  "properties": {
                                    "source_version_ref": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "required": [
                                        "producer_namespace",
                                        "object_type",
                                        "stable_id",
                                        "immutable_version_id"
                                      ],
                                      "properties": {
                                        "producer_namespace": {
                                          "const": "KDB"
                                        },
                                        "object_type": {
                                          "const": "SourceVersion"
                                        },
                                        "stable_id": {
                                          "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                        },
                                        "immutable_version_id": {
                                          "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                        }
                                      }
                                    },
                                    "kind": {
                                      "enum": [
                                        "PAGE",
                                        "TIMECODE",
                                        "SECTION",
                                        "URI"
                                      ]
                                    },
                                    "locator": {
                                      "type": "string"
                                    },
                                    "derivation_ref": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "required": [
                                        "producer_namespace",
                                        "object_type",
                                        "stable_id"
                                      ],
                                      "properties": {
                                        "producer_namespace": {
                                          "type": "string",
                                          "minLength": 1
                                        },
                                        "object_type": {
                                          "const": "DerivationArtifact"
                                        },
                                        "stable_id": {
                                          "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              "lifecycle_revision": {
                                "type": "string",
                                "pattern": "^[0-9]+$"
                              },
                              "integrity_hash": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              "binding_hash": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              "taxonomy_version_ref": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "producer_namespace",
                                  "object_type",
                                  "stable_id",
                                  "immutable_version_id"
                                ],
                                "properties": {
                                  "producer_namespace": {
                                    "const": "KDB"
                                  },
                                  "object_type": {
                                    "const": "TaxonomyVersion"
                                  },
                                  "stable_id": {
                                    "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                  },
                                  "immutable_version_id": {
                                    "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                  }
                                }
                              },
                              "owning_module_ref": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "producer_namespace",
                                  "object_type",
                                  "stable_id"
                                ],
                                "properties": {
                                  "producer_namespace": {
                                    "const": "KDB"
                                  },
                                  "object_type": {
                                    "const": "Module"
                                  },
                                  "stable_id": {
                                    "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                  }
                                }
                              },
                              "relation_refs": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "producer_namespace",
                                    "object_type",
                                    "stable_id"
                                  ],
                                  "properties": {
                                    "producer_namespace": {
                                      "const": "KDB"
                                    },
                                    "object_type": {
                                      "const": "CanonicalRelation"
                                    },
                                    "stable_id": {
                                      "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "execution_profile_ref": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "producer_namespace",
                            "object_type",
                            "stable_id",
                            "immutable_version_id"
                          ],
                          "properties": {
                            "producer_namespace": {
                              "type": "string",
                              "minLength": 1
                            },
                            "object_type": {
                              "type": "string",
                              "minLength": 1
                            },
                            "stable_id": {
                              "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                            },
                            "immutable_version_id": {
                              "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "review_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "producer_namespace",
                "object_type",
                "stable_id"
              ],
              "properties": {
                "producer_namespace": {
                  "type": "string",
                  "minLength": 1
                },
                "object_type": {
                  "const": "ProducerAuditRecord"
                },
                "stable_id": {
                  "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
                }
              }
            }
          }
        },
        "error": false
      }
    }
  ],
  "unevaluatedProperties": false
}
