            },
            "journey_version_id": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "latest"
              }
            },
            "journey_step_id": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "latest"
              }
            }
          }
