{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcava:types:1.0:ResponseEnvelope",
  "title": "Arcava ResponseEnvelope v1.0 — abstract component",
  "description": "Abstract reusable component. Concrete result/error profiles close payload and error.",
  "not": {},
  "$defs": {
    "responseEnvelopeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "schema_version",
        "correlation_id",
        "request_id",
        "outcome",
        "as_of"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "payload": {},
        "error": {}
      }
    }
  }
}
