      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "principal_context_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
