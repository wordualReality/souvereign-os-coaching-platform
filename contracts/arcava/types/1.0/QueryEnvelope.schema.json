          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "requested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "projection_or_resource": {},
        "tenant_scope": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "subject_principal_id"
              ],
              "properties": {
                "kind": {
                  "const": "PERSONAL"
                },
                "subject_principal_id": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "const": "latest"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "tenant_id"
              ],
              "properties": {
                "kind": {
                  "const": "TENANT"
                },
                "tenant_id": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "const": "latest"
                  }
                },
                "client_id": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "const": "latest"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "PUBLIC"
                }
              }
            }
          ]
        },
        "consent_decision_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer_namespace",
            "object_type",
            "stable_id"
          ],
          "properties": {
            "producer_namespace": {
              "const": "PIAC"
            },
            "object_type": {
              "const": "ConsentGrant"
            },
            "stable_id": {
              "$ref": "urn:arcava:types:1.0:QueryEnvelope#/$defs/ID"
            }
