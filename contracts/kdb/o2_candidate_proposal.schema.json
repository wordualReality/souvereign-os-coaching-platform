{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kdb://m01/o2_candidate_proposal/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "contract_id",
    "correlation_id",
    "idempotency_key",
    "issued_at",
    "origin_owner",
    "tenant_scope",
    "principal_context_ref",
    "access_decision_ref",
    "purpose",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "contract_id": {
      "const": "MAP04-C02"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_owner": {
      "enum": [
        "ARCAVA",
        "KDB",
        "APPROVED_EXTERNAL"
      ]
    },
    "tenant_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "principal_context_ref": {
      "type": "string",
      "minLength": 1
    },
    "access_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "submission_id",
        "source_version_id",
        "candidate_id",
        "revision_no",
        "content_sha256",
        "evidence_spans",
        "proposal_payload"
      ],
      "properties": {
        "submission_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "candidate_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_no": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_version_id",
              "locator"
            ],
            "properties": {
              "source_version_id": {
                "type": "string",
                "format": "uuid"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "proposal_payload": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": false
    }
  }
}
