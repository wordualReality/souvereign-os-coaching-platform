{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Synthetic offline research candidate preview",
 "type":"object","additionalProperties":false,
 "required":["schema_version","scope","execution","admission","review_state","model_provider","model_response_authority","provider_gate","extraction_method","decision","reason","provenance"],
 "properties":{
   "schema_version":{"const":"kdb.c08.research-candidate.preview.v1"},
   "scope":{"const":"SYNTHETIC_TEST_ONLY"},"execution":{"const":"NON_EXECUTABLE"},
   "admission":{"const":"NOT_ADMITTED"},"review_state":{"const":"PENDING_REVIEW"},
   "model_provider":{"const":"NONE"},"model_response_authority":{"const":"UNTRUSTED"},
   "provider_gate":{"const":"PROVIDER_EXECUTION_NOT_AUTHORIZED"},"extraction_method":{"const":"DETERMINISTIC_SYNTHETIC_FIXTURE"},
   "decision":{"enum":["CANDIDATE_PREVIEW_ONLY","ABSTAIN"]},"reason":{"type":"string","minLength":1},
   "provenance":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["availability"],"properties":{"availability":{"const":"UNAVAILABLE"}}},
      {"type":"object","additionalProperties":false,
       "required":["availability","source_id","source_version_id","source_sha256","rights_sha256","candidate_revision_id","candidate_revision_sha256","evidence_count","evidence_proofs","safety_review","claim_semantics"],
       "properties":{
         "availability":{"const":"PINNED_UNTRUSTED"},"source_id":{"const":"SYN-SOURCE-ALPHA"},"source_version_id":{"const":"syn-source-version-1"},
         "source_sha256":{"$ref":"#/$defs/sha"},"rights_sha256":{"$ref":"#/$defs/sha"},"candidate_revision_id":{"const":"SYN-CANDIDATE-REV-1"},"candidate_revision_sha256":{"$ref":"#/$defs/sha"},
         "evidence_count":{"type":"integer","minimum":1,"maximum":8},
         "evidence_proofs":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["ordinal","byte_start","byte_end_exclusive","byte_length","local_slice_proof_sha256","proof_scope"],"properties":{"ordinal":{"type":"integer","minimum":1},"byte_start":{"type":"integer","minimum":0},"byte_end_exclusive":{"type":"integer","minimum":1},"byte_length":{"type":"integer","minimum":1},"local_slice_proof_sha256":{"$ref":"#/$defs/sha"},"proof_scope":{"const":"LOCAL_SOURCE_SLICE_ONLY"}}}},
         "safety_review":{"const":"NOT_REVIEWED"},"claim_semantics":{"const":"UNVERIFIED"}
       }}
   ]}
 },
 "$defs":{
   "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
   "input":{
     "type":"object","additionalProperties":false,
     "required":["schema_version","tenant","purpose","as_of","sources","candidate"],
     "properties":{
       "schema_version":{"const":"kdb.c08.research-candidate.preview.v1"},
       "tenant":{"const":"SYNTHETIC_TENANT"},"purpose":{"const":"KDB_HUMAN_REVIEW"},"as_of":{"const":"2026-01-01"},
       "sources":{"type":"array","minItems":1,"maxItems":1,"items":{
         "type":"object","additionalProperties":false,
         "required":["source_id","source_version_id","current_version_id","tenant","purpose","source_text","content_sha256","rights_snapshot","rights_sha256"],
         "properties":{
           "source_id":{"const":"SYN-SOURCE-ALPHA"},"source_version_id":{"const":"syn-source-version-1"},"current_version_id":{"const":"syn-source-version-1"},
           "tenant":{"const":"SYNTHETIC_TENANT"},"purpose":{"const":"KDB_HUMAN_REVIEW"},"source_text":{"type":"string","pattern":"^SYNTHETIC-FIXTURE:"},
           "content_sha256":{"$ref":"#/$defs/sha"},"rights_sha256":{"$ref":"#/$defs/sha"},
           "rights_snapshot":{"type":"object","additionalProperties":false,"required":["source_version_id","tenant","purpose","status","license","checked_as_of","authority"],"properties":{
             "source_version_id":{"const":"syn-source-version-1"},"tenant":{"const":"SYNTHETIC_TENANT"},"purpose":{"const":"KDB_HUMAN_REVIEW"},
             "status":{"const":"ADMITTED"},"license":{"const":"SYNTHETIC_FIXTURE_ONLY"},"checked_as_of":{"const":"2026-01-01"},"authority":{"const":"UNTRUSTED_SYNTHETIC"}
           }}
         }
       }},
       "candidate":{"type":"object","additionalProperties":false,"required":["candidate_revision_id","candidate_revision_sha256","content"],"properties":{
         "candidate_revision_id":{"const":"SYN-CANDIDATE-REV-1"},"candidate_revision_sha256":{"$ref":"#/$defs/sha"},
         "content":{"type":"object","additionalProperties":false,"required":["source_id","source_version_id","source_sha256","rights_sha256","claim_code","safety_review","evidence_span_refs"],"properties":{
           "source_id":{"const":"SYN-SOURCE-ALPHA"},"source_version_id":{"const":"syn-source-version-1"},"source_sha256":{"$ref":"#/$defs/sha"},"rights_sha256":{"$ref":"#/$defs/sha"},
           "claim_code":{"const":"SYN-CANDIDATE-ALPHA"},"safety_review":{"const":"NOT_REVIEWED"},
           "evidence_span_refs":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["source_version_id","locator","start","end","slice_sha256"],"properties":{
             "source_version_id":{"const":"syn-source-version-1"},"locator":{"type":"string","pattern":"^bytes:(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$","maxLength":32},
             "start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":1},"slice_sha256":{"$ref":"#/$defs/sha"}
           }}}
         }}
       }}
     }
   }
 },
 "allOf":[
   {"if":{"properties":{"decision":{"const":"CANDIDATE_PREVIEW_ONLY"}}},"then":{"properties":{"reason":{"const":"SYNTHETIC_REVIEW_HANDOFF_ONLY"},"provenance":{"properties":{"availability":{"const":"PINNED_UNTRUSTED"}}}}}},
   {"if":{"properties":{"decision":{"const":"ABSTAIN"}}},"then":{"properties":{"provenance":{"properties":{"availability":{"const":"UNAVAILABLE"}}}}}}
 ]
}
