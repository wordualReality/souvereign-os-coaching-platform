{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PD01 synthetic consumer-safe morning check-in detail",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "synthetic", "title", "instructions"],
  "properties": {
    "schemaVersion": {"const": "PD01_DETAIL_TEST_ONLY_V1"},
    "synthetic": {"const": true},
    "title": {"type": "string", "minLength": 1, "maxLength": 128},
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
