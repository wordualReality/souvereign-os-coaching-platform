{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kdb://m01/o1_source_ingest/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "contract_id",
    "correlation_id",
    "idempotency_key",
    "issued_at",
    "origin_owner",
    "tenant_scope",
    "principal_context_ref",
    "access_decision_ref",
    "purpose",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "contract_id": {
      "const": "CT-KDB-R03-PIPE-001"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_owner": {
      "enum": [
        "ARCAVA",
        "KDB",
        "APPROVED_EXTERNAL"
      ]
    },
    "tenant_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "principal_context_ref": {
      "type": "string",
      "minLength": 1
    },
    "access_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "submission_id",
        "source_class",
        "source_locator",
        "content_sha256",
        "rights_snapshot_sha256",
        "rights",
        "acquired_at"
      ],
      "properties": {
        "submission_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_class": {
          "enum": [
            "PUBLIC_LINK",
            "LICENSED_DOCUMENT",
            "AUTHORIZED_UPLOAD",
            "OWNER_AUTHORED",
            "MEDIA_REFERENCE"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rights_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rights": {
          "type": "object",
          "required": [
            "rights_status",
            "rights_basis",
            "allowed_purposes"
          ],
          "properties": {
            "rights_status": {
              "const": "ADMITTED"
            },
            "rights_basis": {
              "type": "string",
              "minLength": 1
            },
            "allowed_purposes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
