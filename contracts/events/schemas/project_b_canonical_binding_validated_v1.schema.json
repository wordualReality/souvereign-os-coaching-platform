{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sovereign-os.local/project-b/events/project_b.canonical_binding.validated.v1.schema.json",
  "title": "project_b.canonical_binding.validated.v1",
  "description": "Validate canonical references through DB Canonical adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "source_operation",
    "metadata"
  ],
  "properties": {
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "aggregate_type": {
      "type": "string",
      "const": "canonical_ref_binding"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_operation": {
      "type": "string",
      "const": "validateCanonicalRefsBatch"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "ref_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "valid",
        "invalid",
        "restricted",
        "deprecated",
        "removed",
        "replaced",
        "unsupported",
        null
      ]
    }
  }
}