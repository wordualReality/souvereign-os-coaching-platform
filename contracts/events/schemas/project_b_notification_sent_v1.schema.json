{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sovereign-os.local/project-b/events/project_b.notification.sent.v1.schema.json",
  "title": "project_b.notification.sent.v1",
  "description": "Notification provider accepted message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "source_operation",
    "metadata"
  ],
  "properties": {
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "aggregate_type": {
      "type": "string",
      "const": "notification_delivery"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_operation": {
      "type": "string",
      "const": "sendScheduledNotification"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "channel": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "email",
        "push",
        "sms",
        "in_app",
        null
      ]
    },
    "provider_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_status": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}