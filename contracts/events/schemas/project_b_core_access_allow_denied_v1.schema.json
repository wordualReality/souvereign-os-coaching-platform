{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sovereign-os.local/project-b/events/project_b.core.access_allow_denied.v1.schema.json",
  "title": "project_b.core.access_allow_denied.v1",
  "description": "Core denies access allow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "source_operation",
    "metadata"
  ],
  "properties": {
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "aggregate_type": {
      "type": "string",
      "const": "core_access_decision_ref"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_operation": {
      "type": "string",
      "const": "ingestCoreAccessDecision"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "core_decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "allow",
        "deny",
        "unknown",
        null
      ]
    },
    "decision_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}