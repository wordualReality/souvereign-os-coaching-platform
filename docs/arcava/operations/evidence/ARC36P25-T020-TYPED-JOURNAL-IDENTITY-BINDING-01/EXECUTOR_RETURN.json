  },
  "BOUNDARIES": {
    "mapping": "ClientRelationshipModel.typedIdentity() maps exactly existing tenantId/clientId/versionId/assignmentId/enrollmentId to distinct immutable reference types in same order",
    "scope_comparisons": "requireScope compares tenant/client; requireSameIdentity compares all five; no raw values in mismatch messages; diagnostic redaction",
    "identity_not_authority": "typed references alone prove neither issuer, current storage consistency, publication, lifecycle nor authorization; even equal UUID bytes do not equate distinct namespaces/types",
    "no_aggregate_fabrication": "No CoachAssignment or Enrollment construction from incomplete Journal fields; no role/time/PIAC principal/decision/activation provenance; no active-to-ACTIVE conversion",
    "no_alternate_read_path": "Pure model method does no I/O; OwnerGuard, repository, service, Journal/Kernel, atomic lookup order, PUBLISHED fence, active linkage and legacy public UUID view unchanged",
    "stale_identity": "An old identity may name a withdrawn resource, but cannot restore admission; repository provides no model payload when linkage/publication fails",
    "sensitive_error_boundary": "Existing repository/service still sanitize storage faults and malformed input; new typed mismatch messages and projection diagnostics omit identifiers"
  },
