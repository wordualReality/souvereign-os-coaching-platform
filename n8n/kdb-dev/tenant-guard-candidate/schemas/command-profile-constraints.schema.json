            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_id": {
            "const": "MAP04-C02"
          }
        },
        "required": [
          "command_id"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "source_version_id",
              "derivation_ref",
              "evidence_spans",
              "candidate_digest",
              "semantic_version",
              "model_version"
