{
  "$id": "kdb://offline/configuration-binding/1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "owner": "KDB/Data",
  "properties": {
    "configuration_digest": {
      "type": "string"
    },
    "configuration_revision": {
      "type": "string"
    },
    "endpoint_placeholder": {
      "pattern": "^PLACEHOLDER_KDB_RPC_ENDPOINT/"
    },
    "function_contract_version": {
      "type": "string"
    },
    "function_signature": {
      "type": "string"
    },
    "secret_ref_placeholder": {
      "const": "SECRET_REF_PLACEHOLDER_C3"
    }
  },
  "required": [
    "configuration_revision",
    "configuration_digest",
    "function_signature",
    "function_contract_version"
  ],
  "schema_version": "1.1",
  "status": "OFFLINE_CONTRACT_PROJECTION / NOT_DEPLOYED",
  "type": "object"
}
